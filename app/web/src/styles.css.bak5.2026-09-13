:root {
  --bg: #f3f3ee;
  --panel: #fbfbf8;
  --panel-2: #ffffff;
  --line: rgba(24, 34, 46, 0.1);
  --line-strong: rgba(24, 34, 46, 0.18);
  --ink: #171d26;
  --ink-2: #5a6472;
  --ink-3: #9aa2ad;
  --primary: #1d5fd1;
  --primary-deep: #123f8f;
  --primary-soft: rgba(29, 95, 209, 0.08);
  --primary-ring: rgba(29, 95, 209, 0.22);
  --tank-bg: #0d1b2e;
  --tank-line: rgba(148, 178, 216, 0.14);
  --tank-text: #dfe7f2;
  --tank-dim: #8fa3bd;
  --danger: #a8432a;
  --risk: #c05b3a;
  --radius: 14px;
  --radius-sm: 10px;
  /* 四级字阶：当前最大短板是所有字号差不多，评委 5 秒内读不到层级。
     Display / Title / Body / Meta 拉开对比后，「仪器感」先由排版建立。 */
  --fs-display: clamp(30px, 4vw, 46px);
  --fs-title: 22px;
  --fs-body: 14px;
  --fs-meta: 11.5px;
}

* { box-sizing: border-box; }

/* 任何宽度下都不许横向滚动（spec 4.8 硬性要求），用 clip 兜底 */
html, body { overflow-x: clip; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, "Segoe UI", "PingFang SC", "Microsoft YaHei", "Noto Sans SC", sans-serif;
  font-size: var(--fs-body);
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
}

h1, h2, h3 { font-weight: 500; margin: 0; letter-spacing: 0.2px; }
button { font-family: inherit; }
::selection { background: var(--primary-ring); }

/* 数据产品的可信感一半来自数字排版：所有计数/概率/序号统一等宽数字 + 提一档字重 */
.hot-rank, .prob-num, .stat-chip b, .hud-chip b, .timeline-meta, .mix-bar {
  font-variant-numeric: tabular-nums;
}

/* 内容区放宽到 1320：观测窗要做绝对主角，需要尽量吃满横向空间 */
.app { max-width: 1320px; margin: 0 auto; padding: 0 28px 56px; }

/* ---------- 顶栏 ---------- */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 18px 0 14px;
  border-bottom: 1px solid var(--line);
  margin-bottom: 26px;
}
.brand { display: flex; align-items: center; gap: 12px; }
.brand-mark { width: 34px; height: 34px; flex: none; }
.brand h1 { font-size: 18px; }
.brand .sub { color: var(--ink-3); font-size: 12px; margin-top: 1px; }

.source-badge {
  font-size: 12px;
  padding: 5px 12px;
  border-radius: 999px;
  border: 1px solid var(--line-strong);
  color: var(--ink-2);
  background: var(--panel-2);
}
.source-badge.live { color: #0f6e56; border-color: rgba(15, 110, 86, 0.35); background: rgba(15, 110, 86, 0.07); }
.source-badge.demo { color: #8a5a10; border-color: rgba(196, 138, 33, 0.4); background: rgba(196, 138, 33, 0.08); }

.backlink {
  font-size: 13px;
  color: var(--primary);
  cursor: pointer;
  background: none;
  border: none;
  padding: 0;
}
.backlink:hover { color: var(--primary-deep); }

/* ---------- 按钮 / 输入 ---------- */
.btn {
  border: 1px solid var(--line-strong);
  background: var(--panel-2);
  color: var(--ink);
  border-radius: 10px;
  padding: 8px 16px;
  font-size: 13px;
  cursor: pointer;
  transition: border-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
}
.btn:hover { border-color: var(--primary); color: var(--primary); }
.btn.primary { background: var(--primary); border-color: var(--primary); color: #fff; }
.btn.primary:hover { background: var(--primary-deep); border-color: var(--primary-deep); }
.btn:disabled { opacity: 0.45; cursor: not-allowed; transform: none; }

.searchbar { display: flex; gap: 10px; margin: 22px 0 8px; }
.searchbar input {
  flex: 1;
  min-width: 0;
  border: 1px solid var(--line-strong);
  border-radius: 12px;
  padding: 12px 16px;
  font-size: 14.5px;
  font-family: inherit;
  background: var(--panel-2);
  color: var(--ink);
  transition: border-color 0.15s, box-shadow 0.15s;
}
.searchbar input::placeholder { color: var(--ink-3); }
.searchbar input:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px var(--primary-ring); }

/* ---------- 选题台 ---------- */
/* hero 主张拉到 Display 级：评委只有 3 分钟，第一屏必须先声夺人 */
.hero { padding: 34px 0 6px; }
.hero h2 {
  font-size: var(--fs-display);
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: -0.5px;
}
.hero p { color: var(--ink-2); font-size: 14.5px; margin: 14px 0 0; max-width: 46em; }
.hero .kicker {
  font-size: 12px;
  letter-spacing: 3px;
  color: var(--primary);
  margin-bottom: 12px;
}

/* 三个能力锚点：让评委在滚动前就知道产品有什么；细描边分隔，不抢 hero 的戏 */
.hero-caps {
  display: flex;
  margin: 24px 0 2px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--panel-2);
}
.hero-caps span {
  flex: 1;
  text-align: center;
  padding: 13px 10px;
  font-size: 13px;
  letter-spacing: 0.5px;
  color: var(--ink-2);
}
.hero-caps span + span { border-left: 1px solid var(--line); }

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 36px 0 14px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--line);
}
.section-head h3 { font-size: 20px; }
.section-head .hint { font-size: 12px; color: var(--ink-3); }

.hot-list { display: flex; flex-direction: column; }
.hot-row {
  display: grid;
  grid-template-columns: 52px minmax(0, 1fr) auto;
  gap: 16px;
  align-items: center;
  min-height: 72px;
  padding: 12px 14px;
  border-bottom: 1px solid var(--line);
  border-left: 2px solid transparent;
  transition: background 0.15s, border-color 0.15s;
}
.hot-row:hover { background: var(--panel-2); border-left-color: var(--primary); }
.hot-rank {
  font-size: 22px;
  font-weight: 500;
  color: var(--ink-3);
  text-align: center;
}
.hot-row:nth-child(-n + 3) .hot-rank { color: var(--primary); }
.hot-main { min-width: 0; }
.hot-title { font-size: 15px; font-weight: 500; color: var(--ink); }
.hot-summary {
  font-size: 12.5px;
  color: var(--ink-2);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.hot-actions { display: flex; align-items: center; gap: 14px; flex: none; }
.hot-link { font-size: 12px; color: var(--ink-3); text-decoration: none; }
.hot-link:hover { color: var(--primary); }

/* ---------- 生态缸页布局 ---------- */
/* ≥1280 并排；768–1279 上下堆叠（spec 4.8 断点要求） */
.tank-layout { display: grid; grid-template-columns: minmax(0, 1fr) 372px; gap: 18px; align-items: start; }
@media (max-width: 1279px) {
  .tank-layout { grid-template-columns: 1fr; }
  .panel { position: static; }
}

.tank-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 14px; margin-bottom: 12px; }
.tank-head .q { font-size: var(--fs-title); font-weight: 500; line-height: 1.4; }
.tank-stats { display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap; }
.stat-chip {
  font-size: 12px;
  color: var(--ink-2);
  background: var(--panel-2);
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 3px 11px;
}
.stat-chip b { color: var(--primary); font-weight: 500; }

.narrative {
  margin: 0 0 14px;
  padding: 12px 16px;
  border: 1px solid var(--line);
  border-left: 3px solid var(--primary);
  background: var(--panel-2);
  border-radius: 0 12px 12px 0;
  font-size: 13.5px;
  color: var(--ink-2);
}

/* ---------- 深色观测窗 ---------- */
/* 观测窗是绝对主角：上下留呼吸区，锐角 + 细描边 + 四角刻度线 = 仪器取景框，
   不是圆角卡片。圆角从 16px 收到 3px，刻意制造「设备」气质。 */
.tank-svg-wrap {
  position: relative;
  margin: 18px 0 4px;
  border: 1px solid rgba(13, 27, 46, 0.85);
  border-radius: 3px;
  overflow: hidden;
  background: var(--tank-bg);
  box-shadow: 0 1px 0 rgba(13, 27, 46, 0.05), 0 16px 36px -22px rgba(13, 27, 46, 0.45);
}
.tank-svg-wrap svg { display: block; }

/* 取景框四角刻度线：纯装饰，pointer-events 关掉避免挡节点点击 */
.tank-frame { position: absolute; inset: 0; pointer-events: none; }
.tank-frame i {
  position: absolute;
  width: 15px;
  height: 15px;
  border: 0 solid rgba(148, 178, 216, 0.6);
}
.tank-frame i.tl { top: 9px; left: 9px; border-top-width: 1.5px; border-left-width: 1.5px; }
.tank-frame i.tr { top: 9px; right: 9px; border-top-width: 1.5px; border-right-width: 1.5px; }
.tank-frame i.bl { bottom: 9px; left: 9px; border-bottom-width: 1.5px; border-left-width: 1.5px; }
.tank-frame i.br { bottom: 9px; right: 9px; border-bottom-width: 1.5px; border-right-width: 1.5px; }

/* HUD 芯片贴边悬浮：缩小、压扁、更透，把画面中心让给节点 */
.hud {
  position: absolute;
  top: 10px;
  left: 10px;
  right: 10px;
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  pointer-events: none;
}
.hud-chip {
  font-size: 11px;
  color: var(--tank-text);
  background: rgba(9, 18, 31, 0.55);
  border: 1px solid rgba(148, 178, 216, 0.2);
  border-radius: 999px;
  padding: 3px 10px;
}
.hud-chip b { color: #9cc0f5; font-weight: 500; }

.legend {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  padding: 9px 16px;
  font-size: var(--fs-meta);
  color: var(--tank-dim);
  background: rgba(9, 18, 31, 0.55);
  border-top: 1px solid rgba(148, 178, 216, 0.14);
}
.legend span { display: inline-flex; align-items: center; gap: 5px; }
.legend i { width: 9px; height: 9px; border-radius: 50%; display: inline-block; border: 1px solid rgba(255, 255, 255, 0.35); }
.legend .note { margin-left: auto; color: rgba(143, 163, 189, 0.8); }

/* 节点 hover：描边加粗 + 轻微上浮 120ms，运动只在用户操作后发生（红线） */
.node-g { cursor: pointer; transition: transform 0.12s ease; }
.node-g:hover { transform: translateY(-1px); }
.node-g:hover circle.core { stroke-width: 3; }
.node-g circle.core { transition: stroke-width 0.12s ease; }
.node-tag { pointer-events: none; }

/* ---------- 详情卡 ---------- */
.detail-card {
  margin-top: 14px;
  background: var(--panel-2);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 16px 18px;
}
.detail-card .name { font-weight: 500; color: var(--ink); font-size: 14px; }
.detail-card p { margin: 8px 0; font-size: 13px; color: var(--ink-2); }
.meta-line { font-size: 12px; color: var(--ink-3); }
.quote {
  padding: 8px 12px;
  background: var(--bg);
  border-radius: 8px;
  margin-bottom: 6px;
  font-size: 12.5px;
  color: var(--ink-2);
}

/* ---------- 右侧面板 ---------- */
.panel { display: flex; flex-direction: column; gap: 14px; position: sticky; top: 18px; }

.segmented {
  display: flex;
  background: rgba(24, 34, 46, 0.06);
  border-radius: 12px;
  padding: 3px;
  gap: 2px;
}
.seg-btn {
  flex: 1;
  text-align: center;
  padding: 8px 0;
  font-size: 12.5px;
  border: none;
  border-radius: 9px;
  background: transparent;
  color: var(--ink-2);
  cursor: pointer;
  transition: background 0.15s, color 0.15s;
}
.seg-btn.active { background: var(--panel-2); color: var(--primary); font-weight: 500; box-shadow: 0 1px 2px rgba(20, 30, 40, 0.08); }

.panel-card {
  background: var(--panel-2);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 18px;
}

.panel-title { font-size: 16px; font-weight: 500; margin-bottom: 12px; display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; }

.badge-warn {
  display: inline-block;
  font-size: 11px;
  padding: 2px 9px;
  border-radius: 999px;
  background: rgba(196, 138, 33, 0.1);
  color: #8a5a10;
  border: 1px solid rgba(196, 138, 33, 0.3);
}
.badge-info {
  display: inline-block;
  font-size: 11px;
  padding: 2px 9px;
  border-radius: 999px;
  background: var(--primary-soft);
  color: var(--primary);
  border: 1px solid var(--primary-ring);
}

.field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 13px; }
.field label { font-size: 12px; color: var(--ink-3); }
select {
  border: 1px solid var(--line-strong);
  border-radius: 10px;
  padding: 8px 11px;
  font-family: inherit;
  font-size: 13px;
  background: var(--panel-2);
  color: var(--ink);
}
select:focus { outline: none; border-color: var(--primary); }

.toggle-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 13px;
  color: var(--ink-2);
  padding: 9px 0;
  border-top: 1px solid var(--line);
}
.switch { position: relative; width: 38px; height: 21px; flex: none; }
.switch input { opacity: 0; width: 0; height: 0; }
.switch .track { position: absolute; inset: 0; background: rgba(24, 34, 46, 0.18); border-radius: 999px; transition: background 0.15s; }
.switch .knob { position: absolute; top: 2.5px; left: 2.5px; width: 16px; height: 16px; background: #fff; border-radius: 50%; transition: left 0.15s; box-shadow: 0 1px 2px rgba(20, 30, 40, 0.2); }
.switch input:checked + .track { background: var(--primary); }
.switch input:checked ~ .knob { left: 19.5px; }

.timeline-slider { width: 100%; accent-color: var(--primary); }
.timeline-meta { display: flex; justify-content: space-between; font-size: 12px; color: var(--ink-3); margin-top: 6px; }
.timeline-box {
  margin-top: 14px;
  font-size: 12.5px;
  color: var(--ink-2);
  padding: 11px 13px;
  background: var(--bg);
  border-radius: 10px;
}
.tiny-note { font-size: var(--fs-meta); color: var(--ink-3); margin-top: 12px; line-height: 1.6; }

textarea {
  width: 100%;
  min-height: 132px;
  border: 1px solid var(--line-strong);
  border-radius: 10px;
  padding: 11px 13px;
  font-family: inherit;
  font-size: 13px;
  resize: vertical;
  background: var(--panel-2);
  color: var(--ink);
  transition: border-color 0.15s, box-shadow 0.15s;
}
textarea:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px var(--primary-ring); }

.chip-row { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
.chip {
  font-size: 11.5px;
  padding: 4px 11px;
  border-radius: 999px;
  border: 1px solid var(--line-strong);
  color: var(--ink-2);
  background: var(--panel-2);
  cursor: pointer;
  transition: border-color 0.15s, color 0.15s;
}
.chip:hover { border-color: var(--primary); color: var(--primary); }

/* ---------- 放生报告 ---------- */
.gauge-row { display: flex; align-items: center; gap: 16px; }
.prob-num { font-size: 28px; font-weight: 500; }
.prob-label { font-size: var(--fs-meta); color: var(--ink-3); margin-top: 2px; }

/* 「AI : 规则 = 6:4 混合」从一行灰字改成两段式小条形：
   “混合”是这套预测的核心卖点，必须肉眼可见，而不是埋在注释里 */
.mix-bar {
  display: flex;
  height: 22px;
  border-radius: 6px;
  overflow: hidden;
  border: 1px solid var(--line-strong);
  margin: 8px 0 4px;
  font-size: 11px;
}
.mix-bar span {
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  overflow: hidden;
}
.mix-bar .seg-ai { background: var(--primary); color: #fff; }
.mix-bar .seg-rule { background: var(--primary-soft); color: var(--primary-deep); }

.verdict { font-size: 13.5px; color: var(--ink); margin-top: 10px; }
.report-block { margin-top: 12px; }
.report-block .bt { font-size: 12px; color: var(--ink-3); margin-bottom: 5px; }
.report-list { margin: 0; padding-left: 18px; font-size: 12.5px; color: var(--ink-2); }
.report-list li { margin-bottom: 4px; }
/* 风险 / 杂交建议列表加左侧 2px 色条：风险=暖色警示，建议=主色引导，
   让两类建议在列表层面就能被一眼分开 */
.report-list.strip { list-style: none; padding-left: 0; }
.report-list.strip li { padding-left: 10px; border-left: 2px solid var(--risk); margin-bottom: 6px; }
.report-list.strip.advice li { border-left-color: var(--primary); }
.fine-print { font-size: 11px; color: var(--ink-3); margin-top: 12px; line-height: 1.6; border-top: 1px dashed var(--line); padding-top: 10px; }

.err {
  padding: 11px 15px;
  border: 1px solid rgba(168, 67, 42, 0.35);
  background: rgba(168, 67, 42, 0.06);
  color: var(--danger);
  border-radius: 10px;
  font-size: 13px;
}
.warn-banner {
  padding: 11px 15px;
  border: 1px solid rgba(196, 138, 33, 0.35);
  background: rgba(196, 138, 33, 0.07);
  color: #8a5a10;
  border-radius: 10px;
  font-size: 13px;
}

.loading { color: var(--ink-3); font-size: 13px; padding: 30px 0; text-align: center; }

.footer-note { margin-top: 40px; font-size: 12px; color: var(--ink-3); text-align: center; }

.report-preview { border: 1px solid var(--line); border-radius: 12px; overflow: auto; max-height: 420px; background: #fdfdfb; }

/* ---------- 响应式（<768 单列） ---------- */
@media (max-width: 767px) {
  .app { padding: 0 16px 40px; }
  /* 观测窗在窄屏保持 360 高：内容按 viewBox 等比缩放居中，
     上下留出的深色边带正好呼应「观测窗」气质，节点不会被裁切。
     必须用 > 直接子代选择器：图例里的 12px 策略符号也是 svg，
     不限制作用域会被一起拉成 360px 把图例撑爆 */
  .tank-svg-wrap > svg { height: 360px; }
  /* 窄屏下图例改为文档流（不再悬浮）：390 宽时图例折成三行约 130px，
     而 svg 可视场景只有约 220px 高，悬浮必然盖住节点 */
  .legend { position: static; }
  .hero { padding-top: 22px; }
  .hero-caps span { padding: 10px 4px; font-size: 12px; }
  .hot-row { grid-template-columns: 36px minmax(0, 1fr) auto; gap: 10px; padding: 12px 8px; }
  .hot-rank { font-size: 18px; }
  .hot-actions { gap: 8px; }
  .hot-actions .btn { padding: 7px 10px; }
  .searchbar { flex-direction: column; }
}

/* ---------- 第二轮：标注证据 / AI 解说 / 色轴自适应 ---------- */

/* 数据来源徽标第三态「缓存」（spec 第 7 节）：真实数据的历史缓存用中性蓝灰，
   与实时（绿）、演示（琥珀）在色相上明确分开——三者不是一回事 */
.source-badge.cache { color: #41576e; border-color: rgba(65, 87, 110, 0.35); background: rgba(65, 87, 110, 0.07); }

/* 「缸已就绪」徽标（spec 第 6 节）：绿色系描边芯片，语义=走缓存、零额度 */
.ready-badge {
  display: inline-block;
  margin-left: 8px;
  font-size: 11px;
  font-weight: 400;
  padding: 1px 8px;
  border-radius: 999px;
  color: #0f6e56;
  border: 1px solid rgba(15, 110, 86, 0.4);
  background: rgba(15, 110, 86, 0.06);
  vertical-align: 1px;
}

/* 色轴说明（附录 A1）：缸顶一行小字，讲清当前颜色编码的是哪个维度 */
.axis-note {
  font-size: 12px;
  color: var(--ink-3);
  margin: 0 0 4px;
}

/* 图例主标题：当前颜色编码维度的说明，比普通图例项亮一档 */
.legend .legend-title { color: var(--tank-text); font-weight: 500; }

/* ---------- 判定依据（spec 第 3 节）：命中词 + 权重条 ---------- */
.evidence-block {
  margin-top: 12px;
  padding: 11px 13px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--bg);
}
.ev-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 8px;
  font-size: 12px;
  font-weight: 500;
  color: var(--ink);
  margin-bottom: 8px;
}
.ev-src { font-size: 11px; font-weight: 400; color: var(--ink-3); }
.ev-row { display: flex; align-items: baseline; gap: 8px; font-size: 12px; margin-top: 6px; flex-wrap: wrap; }
.ev-label { color: var(--ink-2); flex: none; }
.ev-items { display: inline-flex; flex-wrap: wrap; gap: 4px 12px; }
.ev-item { display: inline-flex; align-items: center; gap: 5px; }
.ev-item b { font-weight: 500; color: var(--ink); }
.ev-w { color: var(--ink-3); font-size: 11px; font-variant-numeric: tabular-nums; }
/* 权重条：细轨道 + 纯色填充，按行内最大权重归一；不用渐变（设计红线） */
.ev-bar {
  display: inline-block;
  width: 42px;
  height: 5px;
  border: 1px solid var(--line-strong);
  border-radius: 3px;
  overflow: hidden;
}
.ev-bar i { display: block; height: 100%; background: var(--primary); }
.ev-empty { color: var(--ink-3); font-size: 12px; }
.ev-lowconf { margin-top: 8px; font-size: 11.5px; color: #8a5a10; }

/* ---------- AI 生态解说（spec 第 4 节） ---------- */
.narrative-block { margin-top: 0; }
.faction { display: flex; gap: 12px; padding: 10px 0; border-top: 1px solid var(--line); }
.faction:first-of-type { border-top: none; padding-top: 2px; }
/* 派系序号大号 tabular-nums，与热榜编号同一风格族 */
.faction-idx {
  font-size: 22px;
  font-weight: 500;
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
  flex: none;
  line-height: 1.4;
}
.faction-body { min-width: 0; }
.faction-name { font-size: 13.5px; font-weight: 500; color: var(--ink); }
.faction-claim { font-size: 12.5px; color: var(--ink-2); margin-top: 3px; }
.faction-persuasion { font-size: 12px; color: var(--ink-3); margin-top: 2px; }
.faction-dominant {
  margin-top: 10px;
  padding: 10px 12px;
  border: 1px solid var(--line);
  border-left: 3px solid var(--primary);
  border-radius: 0 10px 10px 0;
  font-size: 12.5px;
  color: var(--ink-2);
  display: flex;
  gap: 8px;
  align-items: baseline;
}
.narrative-raw {
  font-size: 12.5px;
  color: var(--ink-2);
  white-space: pre-wrap; /* 保留直答原文换行，不做 markdown 渲染注入 */
  line-height: 1.7;
}
.narrative-empty {
  font-size: 12.5px;
  color: var(--ink-2);
  padding: 11px 13px;
  background: var(--bg);
  border-radius: 10px;
}
